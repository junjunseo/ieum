# 함수 반환값, 반복, 재귀와 중첩 Scope
module math {
  fn factorial(n: int) -> int {
    if n <= 1 {
      return 1
    }
    return n * factorial(n - 1)
  }
}

module app depends math {
  fn main() -> int {
    let sum = 0
    let i = 0
    while i < 10 {
      i = i + 1
      sum = sum + i
    }
    let fact = factorial(5)

    let oddSum = 0
    i = 0
    while true {
      i = i + 1
      if i > 10 {
        break
      }
      if i % 2 == 0 {
        continue
      }
      oddSum = oddSum + i
    }
    return sum + fact
  }
}

layer app above math
