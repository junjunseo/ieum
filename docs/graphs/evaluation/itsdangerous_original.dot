  "itsdangerous__encoding" -> "itsdangerous__exc" [label="depends", color="#2563eb"];
  "itsdangerous__serializer" -> "itsdangerous__encoding" [label="depends", color="#2563eb"];
  "itsdangerous__serializer" -> "itsdangerous__exc" [label="depends", color="#2563eb"];
  "itsdangerous__serializer" -> "itsdangerous__signer" [label="depends", color="#2563eb"];
  "itsdangerous__signer" -> "itsdangerous__encoding" [label="depends", color="#2563eb"];
  "itsdangerous__signer" -> "itsdangerous__exc" [label="depends", color="#2563eb"];
  "itsdangerous__timed" -> "itsdangerous__encoding" [label="depends", color="#2563eb"];
  "itsdangerous__timed" -> "itsdangerous__exc" [label="depends", color="#2563eb"];
  "itsdangerous__timed" -> "itsdangerous__serializer" [label="depends", color="#2563eb"];
  "itsdangerous__timed" -> "itsdangerous__signer" [label="depends", color="#2563eb"];
  "itsdangerous__url_safe" -> "itsdangerous___json" [label="depends", color="#2563eb"];
